# ---------------------------------------------------------------------------
# AI Studio configuration — copy to `.env` and fill in what you need.
# Everything is optional: `python run.py demo --engine silent` works offline.
# ---------------------------------------------------------------------------

# --- scripts (required for new topics; free key at aistudio.google.com) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when a model is retired (HTTP 404) or keeps failing
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Per-request timeout seconds (bounded 10-120); two attempts per model, then fallback
GEMINI_REQUEST_TIMEOUT=60

# --- AI images (Cloudflare Workers AI, free tier) ---------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Fallback image API (free, no key) - throttled automatically
POLLINATIONS_GAP=16

# --- stock footage fallback (free key at pixabay.com/api/docs) --------------
PIXABAY_API_KEY=

# --- voice: pick the engine -------------------------------------------------
# auto = local Chatterbox, else remote Chatterbox, else edge-tts
VOICE_ENGINE=auto
# natural | fast | energetic | documentary (shorts default to fast)
VOICE_PROFILE=natural

# --- Chatterbox (local model) ----------------------------------------------
# multilingual (Hindi + 22 languages) | english | turbo | nano
CHATTERBOX_MODEL=multilingual
# cpu | cuda | mps | xpu (blank = auto-detect). Intel Iris Xe has no supported
# acceleration path, so laptops use cpu — that is expected, not an error.
CHATTERBOX_DEVICE=cpu
# PyTorch intra-op threads. 0 = all cores; leave 2 cores free for ffmpeg.
# CHATTERBOX_THREADS=4
# Only set when intel-extension-for-pytorch is installed (kept fp32 for stability)
# CHATTERBOX_IPEX=0
# v3 = latest multilingual checkpoint
CHATTERBOX_T3=v3
# optional: local Hindi language pack directory (uses from_local)
# CHATTERBOX_CKPT_DIR=assets/models/chatterbox-hi
# 10-20 s clean clip of the voice you want to clone
# CHATTERBOX_REF=assets/voices/reference.wav
# CHATTERBOX_TEMPERATURE=0.8
# CHATTERBOX_REPETITION_PENALTY=1.2

# --- Chatterbox (remote GPU server, recommended for GitHub Actions) --------
# CHATTERBOX_API_URL=http://gpu-box:4123
# CHATTERBOX_API_TOKEN=

# --- edge-tts fallback voices ----------------------------------------------
# Voice ids are discovered at runtime: if Microsoft retires the configured id,
# the engine switches to an available voice for the same locale and logs it.
VOICE_HINDI=hi-IN-MadhurNeural
VOICE_ENGLISH=en-IN-PrabhatNeural
VOICE_FEMALE=hi-IN-SwaraNeural

# --- YouTube upload ---------------------------------------------------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
CHANNEL_NAME=Power Codex
PRIVACY=private
# PUBLISH_AT_IST=19:00

# --- alerts -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- reliability / observability --------------------------------------------
# Per-sentence TTS retries and base backoff (seconds)
VOICE_SYNTH_ATTEMPTS=3
VOICE_RETRY_DELAY=2
# 1 = skip the pre-upload quality gate (not recommended)
# SKIP_QA=0
# text | json  (json adds timestamps + STUDIO_RUN_ID for log shippers)
# STUDIO_LOG_FORMAT=text
# STUDIO_RUN_ID=
# Skip torch probing in `doctor` on machines where importing torch is slow
# STUDIO_SKIP_TORCH_PROBE=0

# --- misc -------------------------------------------------------------------
# 1 = never call image/stock APIs (CI, offline demos)
# STUDIO_OFFLINE=0
# Store generated media outside the repo
# AI_STUDIO_HOME=/var/lib/ai-studio
