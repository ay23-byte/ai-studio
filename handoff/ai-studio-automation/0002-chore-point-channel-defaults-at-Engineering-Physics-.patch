--- a/.env.example
+++ b/.env.example
@@ -30,6 +30,13 @@ POLLINATIONS_GAP=16
 # and Internet Archive are searched without API keys.
 PIXABAY_API_KEY=
 # Mixkit has no supported public search API; use its site manually.
+# Optional, free-tier footage archives (leave blank to skip the provider):
+COVERR_API_KEY=
+DVIDS_API_KEY=
+EUROPEANA_API_KEY=
+NARA_API_KEY=
+# NASA's public media API works keyless at low volume; a key raises the limit.
+NASA_API_KEY=
 
